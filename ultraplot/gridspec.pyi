>>> fig, axs = uplt.subplots(nrows=3, ncols=3)
>>> axs[5]  # the subplot in the second row, third column
>>> axs[1, 2]  # the subplot in the second row, third column
>>> axs[:, 0]  # a SubplotGrid containing the subplots in the first column"""
